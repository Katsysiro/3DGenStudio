# Dependency directories
node_modules/

# Build outputs
dist/

# Electron packaged installers
release/

# Saved images for a NAS deployment (docker_build_nas_*.bat). Hundreds of MB
# each, and rebuilt on demand.
genstudio-server.tar
genstudio-postgres.tar

# Local database and assets (Portable Data).
# Leading slash ANCHORS this to the repo root. Unanchored, `data/` matches a
# directory named "data" at ANY depth — which silently excluded the whole
# thirdparty/skintokens/src/data package from the repo, so a fresh clone could
# not import rig.py at all ("No module named 'src.data'").
/data/

# Local reference ComfyUI install used to generate the managed-install artifacts
# (tools/gen-comfy-lock.mjs reads it; setup/comfyui.json + the lock are the only
# things that get committed). Multi-GB — code, a venv and models. Anchored to the
# repo root so it can't match anything nested.
/comfyui/

# Wiki author mode — presence of this file unlocks editing the Wiki.
# Kept local (never synced) so the published docs are read-only for end users.
.wiki-author

# OS files
.DS_Store
Thumbs.db

# Vite / IDE
.vscode/
.idea/
*.local
.vs/

dev.log
python-server.log

.claude/

# Python
__pycache__/
.venv/

# SkinTokens rigging service — generated / downloaded artifacts (never commit)
thirdparty/skintokens/.venv/
thirdparty/skintokens/rig-server.log
thirdparty/skintokens/experiments/
thirdparty/skintokens/models/
thirdparty/skintokens/tmp_ckpt/
thirdparty/skintokens/tmp_gradio/
thirdparty/skintokens/results/

# Kimodo motion-generation service — generated / downloaded artifacts (never commit)
thirdparty/kimodo/.venv/
thirdparty/kimodo/kimodo-server.log
thirdparty/kimodo/checkpoints/
# Everything downloaded or derived at runtime: the embedding cache and the
# rebased LLM2Vec adapter (a ~170 MB copy of a public HF repo with one JSON field
# rewritten — regenerated on demand, never worth committing or hosting).
thirdparty/kimodo/cache/
# Where the rebased adapter used to live, before it moved under cache/.
thirdparty/kimodo/text-encoder/
thirdparty/kimodo/*.egg-info/
thirdparty/kimodo/MotionCorrection/build/
thirdparty/kimodo/MotionCorrection/*.egg-info/

# MoCapAnything video-to-motion service — generated / downloaded artifacts.
# The service source AND the vendored model tree (MocapAnything/, ~8 MB) ARE
# committed; only what is downloaded or produced at runtime is not.
thirdparty/mocapanything/.venv/
thirdparty/mocapanything/*.log
# The 460 MB checkpoint, wherever it lands. Nested because the vendored tree is
# MocapAnything/checkpoints/ while an override can put it directly under the
# service folder — the same rule electron-builder.yml uses to keep it out of the
# installer.
thirdparty/mocapanything/**/checkpoints/
# Per-rig bakes and their inputs when MOCAP_DATA_DIR is not set (a dev run writes
# them here): the preprocessing tree, the staged FBX, input clips and results.
thirdparty/mocapanything/zoo/
thirdparty/mocapanything/Truebone_Z-OO/
thirdparty/mocapanything/videos/
thirdparty/mocapanything/outputs/

# Docker/server-mode secrets: JWT signing key and the initial admin password.
# .env.docker.example is the committed template; the filled-in .env is not.
/.env
/.env.*
!/.env.docker.example
!/.env.development
!/.env.standalone.example
