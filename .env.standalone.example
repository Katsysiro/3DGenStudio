# Copy to .env.standalone and edit. Used by docker-compose.standalone.yml:
#   docker compose -f docker-compose.standalone.yml --env-file .env.standalone up -d --build

# Host port for the web UI.
GENSTUDIO_PORT=3001

# REQUIRED. The ComfyUI folder ON THE HOST -- the one containing models/
# (and custom_nodes/). It is mounted into this container at /comfyui so the
# setup wizard can download models straight into ComfyUI.
COMFYUI_DIR=/mnt/storage/comfy_data

# How this container reaches ComfyUI.
# ComfyUI publishes port 8188 on the host (docker run -p 8188:8188 ...):
GENSTUDIO_COMFYUI_URL=http://host.docker.internal
GENSTUDIO_COMFYUI_PORT=8188
# ...or, with both on one docker network (see the compose file):
# GENSTUDIO_COMFYUI_URL=http://comfyui
# COMFYUI_NETWORK=comfyui_default

# Only if the models are NOT in $COMFYUI_DIR/models: mount them as an extra
# volume in the compose file and point this at the mount point.
# GENSTUDIO_COMFYUI_MODELS_PATH=/comfyui-models

# login:password for HTTP Basic auth. Set it unless only you can reach the port.
GENSTUDIO_BASIC_AUTH=admin:change-me

# Run as the same user as the ComfyUI container so downloaded models are not
# owned by root. Default 0:0 (root).
# GENSTUDIO_UID=1000:1000

# Behind a reverse proxy:
# PUBLIC_BASE_URL=https://studio.example.com
# TRUST_PROXY_HEADERS=1

# --- Python services ----------------------------------------------------------
# meshtools always starts. The GPU ones start only with a profile:
#   --profile rig | kimodo | mocap | gpu (all three)
#
# CUDA build of torch for the GPU services. Must not be newer than the "CUDA
# Version" that `nvidia-smi` prints on the host: cu126 needs driver 560+,
# cu128 570+, cu130 580+.
TORCH_CUDA=cu126

# Kimodo's ~16 GB text encoder: on the CPU by default (needs ~16 GB free RAM).
# KIMODO_TEXT_ENCODER_DEVICE=cpu
# Don't pre-download it at start-up (it is fetched on the first generation then).
# KIMODO_SKIP_ENCODER=1

# Build meshtools with Warp + CuPy GPU acceleration for Auto Retopo (default off).
# MESHTOOLS_GPU=1
